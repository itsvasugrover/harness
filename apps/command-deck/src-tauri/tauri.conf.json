{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Command Deck",
  "version": "0.1.0",
  "identifier": "dev.harness.command-deck",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Command Deck",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
